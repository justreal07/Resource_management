# Applicants' profile pictures (faces: personal data). Apache no longer serves anything in this folder by its own address.
# The pictures are shown through user/avatar_file.php, which checks who is asking first
# (the applicant who owns the picture, or a signed-in admin or staff member).
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# Whatever else happens, files here must never run as code
Options -Indexes -ExecCGI
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
