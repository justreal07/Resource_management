# Uploaded applicant photos (IDs, certificates: personal data).
# Apache no longer serves anything in this folder by its own address.
# The photos are opened through user/document.php, which checks who is asking first
# (the applicant who sent them, an admin, or OPD staff for OPD requests) and reads the file itself.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# Whatever else happens, files here must never run as code
Options -Indexes -ExecCGI
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
