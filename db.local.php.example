<?php
/**
 * Database settings (read by config.php). Copy this file to db.local.php and fill it in.
 * Keep db.local.php private: it is ignored by git, so never commit it.
 *
 * On a real server, do NOT use root. In phpMyAdmin create a user that only has rights on this database:
 *   CREATE USER 'lgu_app'@'localhost' IDENTIFIED BY 'a-long-random-password';
 *   GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX, DROP, TRIGGER, LOCK TABLES
 *     ON lgu_assistance_system.* TO 'lgu_app'@'localhost';
 * (CREATE/ALTER are needed because the pages add small tables and columns by themselves, e.g. ensure_user_schema().)
 */
return [
    'DB_HOST' => 'localhost',
    'DB_NAME' => 'lgu_assistance_system',
    'DB_USER' => 'lgu_app',
    'DB_PASS' => 'CHANGE-ME',
];
