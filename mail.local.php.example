<?php
/**
 * Gmail account that sends the approval emails (read by includes/mailer.php).
 *
 * Copy this file to mail.local.php and fill in your own values.
 * mail.local.php is ignored by git: never commit it or share it.
 *
 * 1. The Gmail account needs 2-Step Verification turned on.
 * 2. Google Account > Security > App passwords: create one (name it e.g. "LGU assistance").
 * 3. Paste the Gmail address and the 16-letter app password below (spaces don't matter). No restart needed.
 *
 * The environment variables MAIL_USERNAME / MAIL_PASSWORD / MAIL_FROM_NAME override these.
 * With no password, applications are still approved; the admin is told no email was sent.
 */
return [
    'MAIL_USERNAME'  => 'your.office.account@gmail.com',
    'MAIL_PASSWORD'  => 'REPLACE_WITH_YOUR_APP_PASSWORD',
    'MAIL_FROM_NAME' => 'LGU General Mariano Alvarez - Social Assistance',
];
